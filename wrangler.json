{
  "name": "rewindr",
  "compatibility_date": "2026-01-01",
  "pages_build_output_dir": "dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rewindr-db",
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "rewindr-images"
    }
  ]
}
